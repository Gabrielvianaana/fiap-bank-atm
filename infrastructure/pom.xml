<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fiap.bank</groupId>
        <artifactId>fiap-bank-atm</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>infrastructure</artifactId>
    <packaging>jar</packaging>
    <name>fiap-bank-atm :: infrastructure</name>
    <description>Camada de Infraestrutura: persistencia relacional via JDBC puro (SQLite) e Composition Root da aplicacao.</description>

    <!--
      PAPEL DUPLO DESTE MODULO:
      1) Adapter de persistencia: implementa os contratos ditados pelo 'domain'
         usando exclusivamente a API nativa JDBC (nenhum ORM).
      2) Composition Root: hospeda a classe AtmApplication (metodo main), que
         instancia a infraestrutura, injeta no servico de aplicacao e entrega
         o servico pronto para a tela Swing.

      Por que o main mora AQUI e nao em 'presentation'?
      Porque a regra inviolavel nº 2 proibe o POM da apresentacao de referenciar
      'infrastructure'. O ponto de amarracao (wiring) das camadas deve, portanto,
      viver no modulo mais externo do sistema - a infraestrutura - preservando a
      apresentacao 100% cega a detalhes de persistencia.
    -->
    <dependencies>
        <dependency>
            <groupId>com.fiap.bank</groupId>
            <artifactId>domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fiap.bank</groupId>
            <artifactId>application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fiap.bank</groupId>
            <artifactId>presentation</artifactId>
        </dependency>

        <!-- Driver SQLite JDBC (Anexo 7.1) - acesso nativo, sem ORM -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Execucao primaria da aplicacao a partir do Composition Root -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.fiap.bank.atm.AtmApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
